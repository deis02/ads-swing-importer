DirectoryIndex index.php
Options -Indexes

# PHP behind FastCGI does not see the Authorization header unless it is passed on.
<IfModule mod_setenvif.c>
  SetEnvIf Authorization "(.+)" HTTP_AUTHORIZATION=$1
</IfModule>

<Files "lib.php">
  Require all denied
</Files>

<IfModule mod_headers.c>
  Header set Cache-Control "no-store"
</IfModule>
